# Pinned versions and local settings. Don't upgrade mid-POC.
OPENSHELL_VERSION=v0.1.8            # CLI + chart (chart version drops the v: 0.1.8)
AGENT_SANDBOX_VERSION=v1.0.10       # kubernetes-sigs/agent-sandbox sandbox.yaml
OPENSHELL_GATEWAY_PORT=8080
# Local git server for PRs (scripts/gitea-up.sh). Local-only credentials.
GITEA_VERSION=1.24.6
GITEA_PORT=3300
GITEA_USER=poc
GITEA_PASSWORD=poc-password-local
GITEA_REPO=demo-todo
# Single-cluster stack (scripts/up.sh). kagent 1.0.1 installs its own Substrate v1.0.0 fork
# and needs Kubernetes 1.37+ (PodCertificateRequest / ClusterTrustBundle), so kind v0.32+.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0
KAGENT_VERSION=v1.0.1
CLUSTER=poc
KAGENT_UI_PORT=8082
KAGENT_API_PORT=8083
PIPELINE_PORT=8765
CALICO_VERSION_POC=v3.33.0      # Kubernetes 1.37
# Delivery stack (scripts/kargo-up.sh): kargo-hub (Argo CD, Kargo, Rollouts), kargo-nonprod, kargo-prod
# and the kargo-registry. It builds nothing itself; Temporal pushes images and Kargo + Argo CD roll
# them out (scripts/delivery-up.sh, worker/delivery.py). Kubernetes 1.33: what these charts are tested on.
KARGO_NODE_IMAGE=kindest/node:v1.33.1@sha256:050072256b9a903bd914c0b2866828150cb229cea0efe5892e2b644d5dd3b34f
CERT_MANAGER_VERSION=v1.21.3
ARGOCD_CHART_VERSION=10.18.0
ROLLOUTS_CHART_VERSION=2.43.12
KARGO_CHART_VERSION=1.12.5
KARGO_ADMIN_PASSWORD=admin          # Argo CD + Kargo admin, local only
KARGO_HUB_CONTEXT=kind-kargo-hub
KARGO_NONPROD_CONTEXT=kind-kargo-nonprod
KARGO_PROJECT=demo-todo
KARGO_REGISTRY_PUSH=localhost:5002
KARGO_REGISTRY_PULL=kargo-registry:5000
GITOPS_REPO=demo-todo-gitops
GITEA_IN_KIND=http://poc-gitea:3000
PR_PORT_BASE=31100
